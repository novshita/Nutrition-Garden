# Required
OPENAI_API_KEY=
USDA_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nutrition_garden
AUTH_SECRET=
APP_ENV=development

# Optional
AI_MODEL=
# To use another AI provider instead of OpenAI (for example Google Gemini's free tier), set all three:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_API_KEY=<the provider's key>
#   AI_MODEL=<a model name from the provider>
AI_BASE_URL=
AI_API_KEY=
LOG_LEVEL=INFO

# Password-reset emails. Leave SMTP_HOST empty in development: the reset link is then printed in the
# backend log instead of being emailed. APP_BASE_URL is the address people open the app at.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Only for Docker Compose (docker compose up --build): the database password it creates.
POSTGRES_PASSWORD=
